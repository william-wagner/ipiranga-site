---
import Base from '../../layouts/Base.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import CardProduto from '../../components/CardProduto.astro';
import { getCollection } from 'astro:content';

const produtos = (await getCollection('produtos')).sort((a, b) => a.data.ordem - b.data.ordem);
// Agrupa pelo tipo, na ordem em que os tipos aparecem
const grupos = new Map<string, typeof produtos>();
for (const p of produtos) grupos.set(p.data.tipo, [...(grupos.get(p.data.tipo) ?? []), p]);
---
<Base contato="Peça um orçamento" titulo="Produtos" descricao="Redutores de coroa e rosca sem-fim WCR, WCG01 e Magma K. Novos WEG e usados de todas as marcas, com ficha técnica, peças e orçamento pelo WhatsApp.">
  <CabecalhoPagina titulo="Produtos" resumo="Novos, só da WEG. Usados, de todas as marcas. Não sabe qual escolher? Mande os dados da sua máquina pelo WhatsApp." />
  <div class="container lista">
    {[...grupos].map(([tipo, itens]) => (
      <section>
        <h2>{tipo}</h2>
        <ul>
          {itens.map((p) => <li><CardProduto produto={p} destaques={2} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .lista { padding-block: clamp(2.5rem, 6vw, 4rem); display: grid; gap: 2.8rem; }
  h2 { font-size: 1.8rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--azul); margin-bottom: 1.2rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr)); gap: 1.25rem; }
</style>
