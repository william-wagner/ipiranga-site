---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import StatusAberto from '../components/StatusAberto.astro';
import CardProduto from '../components/CardProduto.astro';
import Contato from '../components/Contato.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import Plaqueta from '../components/Plaqueta.astro';
import DesenhoRedutor from '../components/DesenhoRedutor.astro';
import DesenhoExplodido from '../components/DesenhoExplodido.astro';
import { getCollection } from 'astro:content';
import { site, linkTelefone } from '../lib/site';
import empresa from '../data/empresa.json';

const produtos = (await getCollection('produtos')).sort((a, b) => a.data.ordem - b.data.ordem);
const anos = new Date().getFullYear() - empresa.fundacao;
---
<Base titulo={site.nome} descricao={`Redutores e motorredutores novos e usados, peças, acoplamentos e manutenção em Belo Horizonte desde ${empresa.fundacao}. Assistência técnica autorizada WEG. Orçamento pelo WhatsApp.`}>

  <section class="hero prancha">
    <div class="container hero-grade">
      <div class="hero-texto">
        <p class="selo-weg">
          <img src="/images/weg-cestari.png" alt="WEG Cestari" width="230" height="57" />
          <span>Assistência técnica autorizada</span>
        </p>
        <h1>Redutores e motorredutores novos e usados</h1>
        <p class="hero-sub">Venda, conserto e peças em Belo Horizonte desde {empresa.fundacao}. Atendemos indústrias de todo o Brasil.</p>
        <div class="hero-acoes">
          <BotaoWhatsapp grande />
          <a class="btn btn-contorno btn-grande" href={linkTelefone}><Icone nome="telefone" />{site.telefone}</a>
        </div>
        <p class="hero-aviso">O botão verde abre uma conversa no WhatsApp com a nossa equipe. Sem formulário, sem cadastro.</p>
        <StatusAberto />
      </div>
      <div class="hero-desenho">
        <DesenhoRedutor />
      </div>
    </div>
    <div class="container hero-plaqueta">
      <Plaqueta itens={[
        { rotulo: 'Em Belo Horizonte desde', valor: String(empresa.fundacao) },
        { rotulo: 'Assistência técnica', valor: 'Autorizada WEG' },
        { rotulo: 'Redutores e acoplamentos', valor: 'Novos e usados' },
        { rotulo: 'Atendimento', valor: 'Todo o Brasil' },
      ]} />
    </div>
  </section>

  <section class="usados">
    <div class="container usados-grade">
      <figure>
        <img src="/images/empresa/estoque.jpg" alt="Prateleiras do estoque com dezenas de redutores, motorredutores e acoplamentos" width="800" height="600" loading="lazy" />
        <figcaption>Parte do estoque, na nossa loja do Carlos Prates</figcaption>
      </figure>
      <div>
        <h2>Precisa de um redutor para ontem? Veja os usados.</h2>
        <p>Boa parte do que vendemos é equipamento usado. É o caminho mais rápido quando o redutor parou e a máquina não pode esperar prazo de fábrica, ou quando o modelo já saiu de linha.</p>
        <ul class="lista-check">
          <li>Redutores, motorredutores e acoplamentos usados</li>
          <li>Modelos atuais e de linhas antigas, como a Magma</li>
          <li>Revisão na nossa própria oficina</li>
        </ul>
        <BotaoWhatsapp texto="Consultar usados pelo WhatsApp" mensagem="Olá! Vim pelo site e quero consultar redutores usados." />
        <p class="dica">Dica: mande uma foto da plaqueta do seu redutor que a gente procura um igual.</p>
        <a class="link-seta" href="/usados/">Como funciona a compra de usados</a>
      </div>
    </div>
  </section>

  <section class="linhas">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <h2>Linhas que vendemos e consertamos</h2>
          <p>Somos assistência autorizada WEG, mas atendemos redutores de todas as marcas.</p>
        </div>
        <a class="link-seta" href="/produtos/">Todos os produtos</a>
      </div>
      <ul class="grade-produtos">
        {produtos.map((p) => <li><CardProduto produto={p} destaques={2} /></li>)}
      </ul>
    </div>
  </section>

  <section class="manutencao prancha">
    <div class="container manutencao-grade">
      <div>
        <h2>Conserto de redutores, com peça certa e oficina própria</h2>
        <p class="lead">Desmontamos, avaliamos o desgaste e mandamos o orçamento pelo WhatsApp. Se o seu redutor está fora de BH, combinamos o envio.</p>
        <ul class="servicos">
          {empresa.servicos.map((s) => <li><strong>{s.nome}</strong><span>{s.detalhe}</span></li>)}
        </ul>
        <div class="acoes">
          <BotaoWhatsapp texto="Orçamento de conserto pelo WhatsApp" mensagem="Olá! Vim pelo site e preciso de um orçamento de manutenção para um redutor." />
          <a class="link-seta" href="/manutencao/">Como funciona a manutenção</a>
        </div>
      </div>
      <div class="manutencao-desenho">
        <DesenhoExplodido />
      </div>
    </div>
  </section>

  <section class="pecas">
    <div class="container pecas-grade">
      <div>
        <h2>Peças de reposição e acoplamentos</h2>
        <p>Peças avulsas para troca imediata ou programada, e acoplamentos WEG Cestari novos e usados. Não sabe o nome da peça? Mande uma foto.</p>
        <BotaoWhatsapp texto="Pedir peça pelo WhatsApp" mensagem="Olá! Vim pelo site e procuro uma peça de reposição." />
      </div>
      <div class="pecas-listas">
        <div>
          <h3>Para redutores</h3>
          <ul><li>Rolamentos e retentores</li><li>Coroa e rosca sem-fim</li><li>Engrenagens e pinhão</li><li>Eixos, tampas e flanges</li><li>Braço de torção e base</li></ul>
        </div>
        <div>
          <h3>Para acoplamentos</h3>
          <ul><li>Elementos elásticos</li><li>Buchas e pinos</li><li>Arruelas, anéis e porcas</li></ul>
          <a class="link-seta" href="/pecas-e-acoplamentos/">Ver peças e acoplamentos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="clientes">
    <div class="container">
      <h2>{anos} anos atendendo a indústria</h2>
      <p class="sub">Algumas das empresas que já atendemos</p>
      <ul class="nomes">
        {empresa.clientes.map((c) => <li>{c}</li>)}
      </ul>
      <p class="sub">Setores</p>
      <ul class="setores">
        {empresa.setores.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <Contato />
</Base>

<style>
  /* Hero */
  .hero { padding: clamp(2.5rem, 6vw, 4.5rem) 0 0; position: relative; }
  .hero::after { content: ''; position: absolute; inset: auto 0 0 0; height: 3.4rem; background: #fff; }
  .hero-grade { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .selo-weg { display: inline-flex; align-items: center; gap: 0.8rem; margin: 0 0 1.6rem; background: #fff; color: var(--azul-escuro); padding: 0.45rem 0.9rem 0.45rem 0.6rem; border-radius: 4px; font-weight: 600; font-size: 0.95rem; }
  .selo-weg img { height: 1.75rem; width: auto; }
  .selo-weg span { padding-left: 0.8rem; border-left: 1px solid var(--linha); }
  .hero h1 { max-width: 13ch; font-size: clamp(2.7rem, 5.6vw, 4.4rem); }
  .hero-sub { font-size: clamp(1.15rem, 1.6vw, 1.3rem); color: #dbe4fb; max-width: 32rem; margin-bottom: 1.8rem; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hero-aviso { margin: 0.9rem 0 1.2rem; font-size: 0.95rem; color: var(--azul-claro); max-width: 30rem; }
  .hero :global(.status) { color: #dbe4fb; }
  .hero-desenho { min-width: 0; }
  .hero-plaqueta { position: relative; z-index: 1; margin-top: clamp(2rem, 5vw, 3.5rem); }

  /* Traço do desenho aparece uma vez, ao carregar */
  .hero-desenho :global(.traco) { stroke-dasharray: 2400; stroke-dashoffset: 2400; animation: desenhar 2.2s ease-out 0.2s forwards; }
  @keyframes desenhar { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-desenho :global(.traco) { stroke-dashoffset: 0; } }

  /* Usados */
  .usados { padding-block: var(--secao); }
  .usados-grade { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .usados figure { margin: 0; }
  .usados figure img { width: 100%; border-radius: var(--raio); }
  .usados figcaption { margin-top: 0.7rem; font-size: 0.92rem; color: var(--cinza); }
  .usados h2 { max-width: 16ch; }
  .lista-check { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: 0.5rem; }
  .lista-check li { padding-left: 1.6rem; position: relative; font-weight: 500; }
  .lista-check li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 0.75rem; height: 0.4rem; border-left: 3px solid var(--laranja); border-bottom: 3px solid var(--laranja); transform: rotate(-45deg); }
  .dica { margin: 0.9rem 0 1rem; font-size: 0.95rem; color: var(--cinza); }

  /* Linhas */
  .linhas { background: var(--aco); padding-block: var(--secao); }
  .cabecalho-secao { display: flex; justify-content: space-between; align-items: end; gap: 1rem 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .cabecalho-secao h2 { margin-bottom: 0.3em; }
  .cabecalho-secao p { margin: 0; color: var(--cinza); }
  .grade-produtos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr)); gap: 1.5rem; }

  /* Manutenção */
  .manutencao { padding-block: var(--secao); }
  .manutencao-grade { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .manutencao h2 { max-width: 16ch; }
  .lead { color: #dbe4fb; font-size: 1.15rem; max-width: 34rem; }
  .servicos { list-style: none; padding: 0; margin: 1.6rem 0 2rem; border-top: 1px solid var(--azul-linha); }
  .servicos li { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--azul-linha); }
  .servicos strong { font: 600 1.25rem/1.25 var(--fonte-titulo); }
  .servicos span { color: #c4cfea; }
  .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .manutencao-desenho { min-width: 0; }

  /* Peças */
  .pecas { padding-block: var(--secao); border-bottom: 1px solid var(--linha); }
  .pecas-grade { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 5vw, 4.5rem); }
  .pecas h2 { max-width: 14ch; }
  .pecas-listas { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .pecas-listas h3 { padding-bottom: 0.5rem; border-bottom: 2px solid var(--azul); }
  .pecas-listas ul { list-style: none; padding: 0; margin: 0 0 1.2rem; }
  .pecas-listas li { padding: 0.45rem 0; border-bottom: 1px solid var(--linha); }

  /* Clientes */
  .clientes { padding-block: var(--secao); }
  .sub { color: var(--cinza); font-weight: 500; margin: 1.6rem 0 0.8rem; }
  .nomes { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 2.6rem; }
  .nomes li { font: 700 clamp(1.6rem, 3vw, 2.3rem)/1.2 var(--fonte-titulo); color: var(--azul); }
  .setores { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .setores li { padding: 0.45rem 0.95rem; background: var(--aco); border-radius: 999px; font-weight: 500; font-size: 0.97rem; }

  @media (max-width: 62rem) {
    .hero-grade, .usados-grade, .manutencao-grade, .pecas-grade { grid-template-columns: 1fr; }
    .hero-desenho { max-width: 34rem; }
    .manutencao-desenho { max-width: 32rem; }
  }
  @media (max-width: 40rem) {
    .servicos li { grid-template-columns: 1fr; gap: 0.1rem; }
    .pecas-listas { grid-template-columns: 1fr; gap: 0.5rem; }
    .hero-acoes :global(.btn) { width: 100%; }
  }
</style>
