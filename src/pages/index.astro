---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import StatusAberto from '../components/StatusAberto.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import FaixaClientes from '../components/FaixaClientes.astro';
import DesenhoRedutor from '../components/DesenhoRedutor.astro';
import DesenhoExplodido from '../components/DesenhoExplodido.astro';
import { site, linkTelefone } from '../lib/site';
import { foto } from '../lib/fotos';
import empresa from '../data/empresa.json';

const anos = new Date().getFullYear() - empresa.fundacao;

// Fotos entram sozinhas quando o arquivo existir em public/images/fotos/ (veja o LEIA-ME de lá)
const fotoHero = foto('hero');
const fotoEmpresa = foto('empresa');
const fotoServicos = foto('manutencao');

const linhas = [
  {
    titulo: 'Equipamentos novos',
    sub: 'Revenda e assistência técnica autorizada WEG Cestari',
    itens: ['Redutores', 'Motorredutores', 'Peças de reposição'],
    foto: foto('produto-novos'),
    mensagem: 'Olá! Vim pelo site e quero um orçamento de equipamento novo WEG.',
  },
  {
    titulo: 'Equipamentos usados',
    sub: 'Diversas marcas e modelos',
    itens: ['Redutores e motorredutores usados', 'SEW, Falk, Flender, Transmotécnica, Sumitomo e dentre outros', 'Equipamentos fora de linha'],
    foto: foto('produto-usados'),
    mensagem: 'Olá! Vim pelo site e quero consultar equipamentos usados.',
  },
  {
    titulo: 'Peças e acoplamentos',
    sub: 'Componentes para manutenção e reposição',
    itens: ['Acoplamentos diversos', 'Coroas, roscas sem-fim, flanges e cubos entalhados', 'Válvulas, eixos de entrada/saída e eixos vazados com coroa', 'Óleo específico para redutores, fracionado'],
    foto: foto('produto-pecas'),
    mensagem: 'Olá! Vim pelo site e procuro peças ou acoplamentos.',
  },
];
---
<Base titulo={site.nome} descricao={`Redutores e motorredutores novos e usados, manutenção e peças de reposição em Belo Horizonte desde ${empresa.fundacao}. Assistência técnica autorizada WEG Cestari.`}>

  <section id="inicio" class:list={['hero', 'escuro', { 'com-foto': fotoHero }]} style={fotoHero ? `--foto: url(${fotoHero})` : undefined}>
    <div class="container hero-grade">
      <div class="hero-texto">
        <p class="selo-weg">
          <img src="/images/weg-cestari.png" alt="WEG Cestari" width="230" height="57" />
          <span>Assistência técnica autorizada</span>
        </p>
        <h1>Redutores e motorredutores novos e usados</h1>
        <p class="hero-sub">Venda de equipamentos novos e usados, manutenção e peças de reposição para diversas aplicações industriais. Atendemos clientes em todo o Brasil.</p>
        <div class="hero-acoes">
          <BotaoWhatsapp grande />
          <a class="btn btn-contorno btn-grande" href={linkTelefone}><Icone nome="telefone" />{site.telefone}</a>
        </div>
        <StatusAberto />
      </div>
      {!fotoHero && <div class="hero-desenho"><DesenhoRedutor /></div>}
    </div>
  </section>

  <section id="empresa" class="empresa">
    <div class="container">
      <div class:list={['empresa-grade', { 'com-foto': fotoEmpresa }]}>
        <div class="empresa-texto">
          <h2>Há {anos} anos, mantendo a indústria em movimento</h2>
          <p>Desde {empresa.fundacao}, a Ipiranga Redutores oferece soluções em redutores e motorredutores para a indústria. Trabalhamos com equipamentos novos e usados, peças de reposição, manutenção e assistência técnica autorizada WEG Cestari.</p>
          <p>Sabemos que máquina parada significa prejuízo. Por isso, unimos experiência, agilidade e conhecimento técnico para encontrar soluções que atendam às necessidades de cada cliente, inclusive em situações de urgência, ajudando a reduzir o tempo de parada e a manter a produção em funcionamento.</p>
          <p class="assinatura">Ipiranga Redutores: experiência e agilidade para a indústria não parar.</p>
        </div>
        {fotoEmpresa && <img class="empresa-foto" src={fotoEmpresa} alt="Fachada da Ipiranga Redutores, na Av. Nossa Senhora de Fátima, 2215" width="1100" height="788" loading="lazy" />}
      </div>
      <p class="sub">Algumas das empresas que já atendemos</p>
      <FaixaClientes clientes={empresa.clientes} />
      <p class="sub">Setores</p>
      <ul class="setores">
        {empresa.setores.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section id="produtos" class="produtos">
    <div class="container">
      <div class="prod-topo">
        <h2>Redutores, motorredutores e peças para indústria</h2>
        <p>Redutores, motorredutores e acoplamentos. O novo vem com garantia de fábrica; o usado resolve rápido quando a máquina parou ou o modelo saiu de linha.</p>
      </div>
      <div class="prod-grade">
        {linhas.map((l) => (
          <article>
            {l.foto
              ? <img class="prod-foto" src={l.foto} alt="" width="1448" height="1086" loading="lazy" />
              : <div class="prod-foto vazia">Espaço para imagem</div>}
            <h3>{l.titulo}</h3>
            <p class="marca">{l.sub}</p>
            <ul class="lista-check">{l.itens.map((i) => <li>{i}</li>)}</ul>
            <BotaoWhatsapp mensagem={l.mensagem} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="servicos" class="servicos-sec escuro">
    <div class="container servicos-grade">
      <div>
        <h2>Serviços</h2>
        <ul class="servicos">
          {empresa.servicos.map((s) => <li><strong>{s.nome}</strong><span>{s.detalhe}</span></li>)}
        </ul>
        <BotaoWhatsapp mensagem="Olá! Vim pelo site e preciso de um orçamento de manutenção para um redutor." />
      </div>
      <div class="servicos-imagem">
        {fotoServicos
          ? <img src={fotoServicos} alt="Técnico trocando o rolamento de um redutor na bancada da oficina" width="1448" height="1086" loading="lazy" />
          : <DesenhoExplodido />}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Topo */
  .hero { padding: clamp(1.5rem, 3.2vw, 2.75rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .hero.com-foto {
    background-image: linear-gradient(90deg, rgba(15, 25, 56, 0.94) 0%, rgba(15, 25, 56, 0.78) 45%, rgba(15, 25, 56, 0.25) 100%), var(--foto);
    background-size: cover; background-position: center;
  }
  .hero-grade { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .com-foto .hero-grade { grid-template-columns: 1fr; }
  .selo-weg { display: inline-flex; align-items: center; gap: 0.8rem; margin: 0 0 1.25rem; background: #fff; color: var(--azul-escuro); padding: 0.45rem 0.9rem 0.45rem 0.6rem; border-radius: 4px; font-weight: 600; font-size: 0.95rem; }
  .selo-weg img { height: 1.75rem; width: auto; }
  .selo-weg span { padding-left: 0.8rem; border-left: 1px solid var(--linha); }
  .hero h1 { max-width: 13ch; font-size: clamp(2.6rem, 5vw, 4.1rem); margin-bottom: 0.35em; }
  .hero-sub { font-size: clamp(1.15rem, 1.6vw, 1.3rem); color: #dbe4fb; max-width: 32rem; margin-bottom: 1.5rem; }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1.3rem; }
  .hero :global(.status) { color: #dbe4fb; }
  .hero-desenho { min-width: 0; }
  .hero-desenho :global(.traco) { stroke-dasharray: 2400; stroke-dashoffset: 2400; animation: desenhar 2.2s ease-out 0.2s forwards; }
  @keyframes desenhar { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-desenho :global(.traco) { stroke-dashoffset: 0; } }

  /* A empresa */
  .empresa { padding-block: var(--secao); }
  .empresa-grade.com-foto { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .empresa h2 { max-width: 18ch; }
  .empresa-texto p { color: var(--cinza); font-size: 1.08rem; max-width: 40rem; }
  .empresa-texto .assinatura { color: var(--grafite); font-weight: 600; opacity: 0.85; margin-bottom: 0; }
  .empresa-foto { width: 100%; border-radius: var(--raio); }
  .sub { color: var(--cinza); font-weight: 500; margin: 2.2rem 0 0.8rem; }
  .setores { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .setores li { padding: 0.45rem 0.95rem; background: var(--aco); border-radius: 999px; font-weight: 500; font-size: 0.97rem; }

  /* Produtos */
  .produtos { padding-block: var(--secao); }
  .prod-topo { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem clamp(2rem, 5vw, 4.5rem); align-items: end; margin-bottom: 2.2rem; }
  .prod-topo h2 { margin: 0; max-width: 14ch; }
  .prod-topo p { margin: 0; color: var(--cinza); font-size: 1.05rem; }
  .prod-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .prod-grade article { display: flex; flex-direction: column; align-items: flex-start; padding: 1.5rem; border: 1px solid var(--linha); border-top: 4px solid var(--laranja); border-radius: var(--raio); }
  .prod-grade article:first-child { border-top-color: var(--azul); }
  .prod-foto { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--raio); margin-bottom: 1.4rem; }
  .prod-foto.vazia { display: grid; place-items: center; background: var(--aco); border: 1px dashed var(--aco-escuro); color: #8a95aa; font-weight: 600; }
  .prod-grade h3 { font-size: 2rem; margin: 0 0 0.2rem; }
  .marca { font-weight: 600; color: var(--cinza); margin-bottom: 1rem; }
  .lista-check { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.5rem; flex: 1; align-content: start; }
  .lista-check li { padding-left: 1.6rem; position: relative; font-weight: 500; }
  .lista-check li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 0.75rem; height: 0.4rem; border-left: 3px solid var(--laranja); border-bottom: 3px solid var(--laranja); transform: rotate(-45deg); }
  .prod-grade :global(.btn) { width: 100%; }

  /* Serviços */
  .servicos-sec { padding-block: var(--secao); }
  .servicos-grade { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .servicos { list-style: none; padding: 0; margin: 1.4rem 0 2rem; border-top: 1px solid var(--azul-linha); }
  .servicos li { display: grid; grid-template-columns: 15rem 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--azul-linha); }
  .servicos strong { font: 600 1.25rem/1.25 var(--fonte-titulo); }
  .servicos span { color: #c4cfea; }
  .servicos-imagem { min-width: 0; }
  .servicos-imagem img { width: 100%; border-radius: var(--raio); }

  @media (max-width: 62rem) {
    .hero-grade, .empresa-grade.com-foto, .prod-topo, .servicos-grade { grid-template-columns: 1fr; }
    .prod-grade { grid-template-columns: 1fr 1fr; }
    .hero-desenho { max-width: 34rem; }
  }
  @media (max-width: 40rem) {
    .prod-grade { grid-template-columns: 1fr; }
    .servicos li { grid-template-columns: 1fr; gap: 0.1rem; }
    .hero-acoes :global(.btn) { width: 100%; }
  }
</style>
