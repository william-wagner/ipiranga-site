---
interface Props { titulo: string; resumo?: string; trilha?: { href: string; label: string } }
const { titulo, resumo, trilha } = Astro.props;
---
<div class="cabecalho escuro">
  <div class="container">
    {trilha && <a class="trilha" href={trilha.href}>{trilha.label}</a>}
    <h1>{titulo}</h1>
    {resumo && <p>{resumo}</p>}
    <slot />
  </div>
</div>

<style>
  .cabecalho { padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(2.8rem, 6vw, 4.2rem); border-bottom: 3px solid var(--laranja); }
  .cabecalho h1 { font-size: clamp(2.5rem, 5.5vw, 4rem); margin: 0; max-width: 20ch; }
  .cabecalho p { margin: 0.9rem 0 0; color: #dbe4fb; font-size: 1.18rem; max-width: 42rem; }
  .cabecalho .trilha { display: inline-block; color: var(--azul-claro); margin-bottom: 0.7rem; font-weight: 500; text-decoration: none; }
  .cabecalho .trilha::before { content: '‹ '; }
  .cabecalho .trilha:hover { color: #fff; text-decoration: underline; }
</style>
