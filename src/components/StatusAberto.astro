---
// Mostra "Aberto agora" ou "Fechado agora" no horário de Belo Horizonte.
// Calculado no navegador do visitante, então sempre está atualizado.
// O script é inline e fica logo após o elemento: roda durante a leitura do
// HTML, antes da primeira pintura da tela. Assim o texto já aparece no lugar
// certo, sem empurrar o conteúdo depois (evita CLS). Por isso é JS puro.
import { site } from '../lib/site';
---
<p class="status" data-horario={JSON.stringify(site.horario)} hidden>
  <span class="ponto" aria-hidden="true"></span><span class="texto"></span>
</p>

<script is:inline>
  (function () {
    var el = document.currentScript.previousElementSibling;
    var fmt = function (h) {
      var p = h.split(':');
      return p[1] && p[1] !== '00' ? Number(p[0]) + 'h' + p[1] : Number(p[0]) + 'h';
    };
    var minutos = function (h) { var p = h.split(':').map(Number); return p[0] * 60 + p[1]; };

    var horario = JSON.parse(el.dataset.horario || '{}');
    var agora = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));
    var dia = agora.getDay();
    var f = (dia === 0 ? horario.domingo : dia === 6 ? horario.sabado : horario.semana) || {};
    var m = agora.getHours() * 60 + agora.getMinutes();
    var aberto = f.abre && f.fecha && m >= minutos(f.abre) && m < minutos(f.fecha);
    el.classList.toggle('aberto', !!aberto);
    el.querySelector('.texto').textContent = aberto
      ? 'Aberto agora, até as ' + fmt(f.fecha)
      : 'Fechado agora. Deixe sua mensagem no WhatsApp';
    el.hidden = false;
  })();
</script>

<style>
  .status { display: inline-flex; align-items: center; gap: 0.55rem; margin: 0; font-weight: 500; }
  .ponto { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #9aa4b8; }
  .aberto .ponto { background: #3fcf73; box-shadow: 0 0 0 4px rgba(63, 207, 115, 0.25); }
</style>
