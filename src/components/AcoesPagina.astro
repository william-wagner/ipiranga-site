---
// Fim do texto das páginas internas: orçamento pelo WhatsApp e link para a página inicial.
// Quem chega pelo Google direto numa dessas páginas ganha um caminho para conhecer o resto do site.
import BotaoWhatsapp from './BotaoWhatsapp.astro';
import { site } from '../lib/site';

interface Props { texto?: string; mensagem?: string }
const { texto, mensagem } = Astro.props;
---
<div class="acoes">
  <BotaoWhatsapp texto={texto} mensagem={mensagem} grande />
  <a class="link-seta" href="/">Conheça a {site.nome} <span aria-hidden="true">→</span></a>
</div>

<style>
  .acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 2.2rem; padding-top: 1.6rem; border-top: 1px solid var(--linha); }
  @media (max-width: 40rem) { .acoes :global(.btn) { width: 100%; } }
</style>
