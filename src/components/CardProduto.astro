---
import type { CollectionEntry } from 'astro:content';
interface Props { produto: CollectionEntry<'produtos'> }
const { produto } = Astro.props;
const { titulo, tipo, imagem } = produto.data;
---
<a class="card" href={`/produtos/${produto.id}/`}>
  <div class="foto">
    {imagem && <img src={imagem} alt={`Redutor ${titulo}`} loading="lazy" width="400" height="300" />}
  </div>
  <span class="tipo">{tipo}</span>
  <span class="nome">{titulo}</span>
</a>

<style>
  .card { display: flex; flex-direction: column; height: 100%; background: #fff; text-decoration: none; color: var(--grafite); border: 1px solid var(--linha); border-radius: 4px; overflow: hidden; }
  .card:hover { border-color: var(--azul); color: var(--grafite); }
  .card:hover .nome { color: var(--azul); }
  .foto { aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 0.8rem; border-bottom: 1px solid var(--linha); }
  .foto img { width: 100%; height: 100%; object-fit: contain; }
  .tipo { padding: 0.9rem 1rem 0; font-size: 0.9rem; color: var(--cinza); }
  .nome { padding: 0.1rem 1rem 1rem; font-family: var(--fonte-titulo); font-weight: 700; font-size: 1.5rem; line-height: 1.15; }
  @media (max-width: 30rem) {
    .tipo { padding: 0.7rem 0.7rem 0; font-size: 0.82rem; }
    .nome { padding: 0.1rem 0.7rem 0.8rem; font-size: 1.25rem; }
  }
</style>
