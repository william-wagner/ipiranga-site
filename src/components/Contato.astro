---
import Icone from './Icone.astro';
import StatusAberto from './StatusAberto.astro';
import { site, horarios, linkWhatsapp, linkTelefone, enderecoCompleto, linkMapa, embedMapa } from '../lib/site';
interface Props { titulo?: string; nivel?: 'h1' | 'h2' }
const { titulo = 'Fale com a gente', nivel = 'h2' } = Astro.props;
const H = nivel;
---
<section class="contato">
  <div class="container contato-grade">
    <div>
      <H>{titulo}</H>
      <p class="intro">Tire dúvidas, peça um orçamento ou combine o envio do seu redutor para manutenção.</p>
      <div class="acoes">
        <a class="btn btn-acao" href={linkWhatsapp}><Icone nome="whatsapp" />Chamar no WhatsApp</a>
        <a class="btn btn-azul" href={linkTelefone}><Icone nome="telefone" />Ligar {site.telefone}</a>
      </div>
      <ul class="dados">
        <li><Icone nome="email" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icone nome="local" /><a href={linkMapa}>{enderecoCompleto}</a></li>
        <li><Icone nome="relogio" /><div>
          <StatusAberto />
          <dl>{horarios.map((h) => (<><dt>{h.dias}</dt><dd>{h.horas}</dd></>))}</dl>
        </div></li>
      </ul>
    </div>
    <div class="mapa">
      <iframe src={embedMapa} title={`Mapa: ${enderecoCompleto}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <a href={linkMapa}>Abrir no Google Maps</a>
    </div>
  </div>
</section>

<style>
  .contato { padding-block: clamp(3rem, 7vw, 5rem); border-top: 1px solid var(--linha); }
  .contato-grade { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); }
  .intro { color: var(--cinza); max-width: 30rem; }
  .acoes { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 1.4rem 0 2rem; }
  .dados { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .dados > li { display: flex; gap: 0.8rem; align-items: flex-start; }
  .dados > li > :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; margin-top: 0.2rem; color: var(--azul); }
  .dados :global(.status) { margin-bottom: 0.4rem; }
  dl { margin: 0; display: grid; grid-template-columns: auto auto; gap: 0.2rem 1.2rem; justify-content: start; }
  dt { color: var(--cinza); }
  dd { margin: 0; font-weight: 500; }
  .mapa iframe { width: 100%; aspect-ratio: 4 / 3; border: 1px solid var(--linha); border-radius: 4px; display: block; }
  .mapa a { display: inline-block; margin-top: 0.6rem; font-weight: 600; }
  @media (max-width: 52rem) { .contato-grade { grid-template-columns: 1fr; } }
</style>
