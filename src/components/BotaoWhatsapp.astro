---
// Botão de orçamento. O texto sempre diz que é pelo WhatsApp, para o cliente saber
// que não vai cair num formulário nem no e-mail.
import Icone from './Icone.astro';
import { site, whatsappCom } from '../lib/site';

interface Props { texto?: string; mensagem?: string; grande?: boolean; class?: string }
const { texto = 'Orçamento pelo WhatsApp', mensagem = site.mensagemWhatsapp, grande = false, class: classe = '' } = Astro.props;
---
<a class:list={['btn', 'btn-wa', { 'btn-grande': grande }, classe]} href={whatsappCom(mensagem)} target="_blank" rel="noopener">
  <Icone nome="whatsapp" />{texto}
</a>
