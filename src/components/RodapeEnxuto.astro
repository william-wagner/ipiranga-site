---
// Rodapé curto: logo e menu; embaixo, selo WEG, frase e direitos.
// O contato completo fica na seção acima (Contato.astro).
import { site } from '../lib/site';
import { menu, hrefSecao } from '../lib/menu';
import empresa from '../data/empresa.json';

interface Props { naHome?: boolean }
const { naHome = false } = Astro.props;
---
<footer class="rodape">
  <div class="container linha">
    <a href={naHome ? '#inicio' : '/'} class="marca" aria-label={`${site.nome} – início`}>
      <img src="/images/logo-branco.png" alt={site.nome} width="531" height="80" loading="lazy" />
    </a>
    <nav aria-label="Rodapé">
      <ul>{menu.map((m) => <li><a href={hrefSecao(m.secao, naHome)}>{m.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="container fim">
    <img class="weg" src="/images/weg-cestari.png" alt="WEG-CESTARI" width="230" height="57" loading="lazy" />
    <p>Assistência técnica autorizada WEG-CESTARI. Em Belo Horizonte desde {empresa.fundacao}.</p>
    <p class="direitos">© {new Date().getFullYear()} {site.nome}</p>
  </div>
</footer>

<style>
  .rodape { background: var(--azul-noite); color: #9fabc8; padding: 2.2rem 0 1.6rem; border-top: 1px solid var(--azul-linha); }
  p { margin: 0; }
  .linha { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 2.5rem; padding-bottom: 1.6rem; }
  .marca img { height: 2.1rem; width: auto; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; }
  ul a { color: #dbe4fb; text-decoration: none; text-transform: uppercase; letter-spacing: 0.02em; font-weight: 500; }
  ul a:hover { color: #fff; text-decoration: underline; }
  .fim { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.4rem; padding-top: 1.3rem; border-top: 1px solid var(--azul-linha); font-size: 0.9rem; }
  .weg { height: 1.9rem; width: auto; background: #fff; padding: 0.3rem 0.55rem; border-radius: 4px; }
  .direitos { margin-left: auto; }
  @media (max-width: 40rem) {
    .rodape { padding-bottom: 6rem; }
    .direitos { margin-left: 0; }
  }
</style>
