---
// Rodapé curto: nome, endereço e contatos. O contato completo fica na seção acima (Contato.astro).
import Icone from './Icone.astro';
import { site, linkTelefone, linkMapa } from '../lib/site';
import empresa from '../data/empresa.json';
---
<footer class="rodape">
  <div class="container linha">
    <div class="marca">
      <p class="nome">{site.nome}</p>
      <p>Assistência técnica autorizada WEG. Em Belo Horizonte desde {empresa.fundacao}.</p>
    </div>
    <ul class="contatos">
      <li><Icone nome="local" /><a href={linkMapa} target="_blank" rel="noopener">{site.endereco} · BH/MG</a></li>
      <li><Icone nome="telefone" /><a href={linkTelefone}>{site.telefone}</a></li>
      <li><Icone nome="email" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </div>
  <div class="container fim">
    <p>© {new Date().getFullYear()} {site.nome}</p>
    <p><a href="#top">Voltar ao topo ↑</a></p>
  </div>
</footer>

<style>
  .rodape { background: var(--azul-noite); color: #9fabc8; padding: 2.4rem 0 1.4rem; }
  .rodape a { color: inherit; text-decoration: none; }
  .rodape a:hover { color: #fff; text-decoration: underline; }
  p { margin: 0; }

  .linha { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.6rem 3rem; padding-bottom: 1.8rem; }
  .nome { color: #fff; font-weight: 600; font-size: 1.1rem; margin-bottom: 0.25rem; }
  .contatos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; color: #dbe4fb; }
  .contatos li { display: flex; align-items: center; gap: 0.7rem; }
  .contatos :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; color: var(--laranja); }

  .fim { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 2rem; padding-top: 1.2rem; border-top: 1px solid var(--azul-linha); font-size: 0.88rem; }

  @media (max-width: 40rem) {
    .rodape { padding-bottom: 6rem; }
  }
</style>
