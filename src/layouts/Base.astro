---
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import Contato from '../components/Contato.astro';
import RodapeEnxuto from '../components/RodapeEnxuto.astro';
import empresa from '../data/empresa.json';
import { site, linkWhatsapp, linkTelefone } from '../lib/site';
import { menu, hrefSecao } from '../lib/menu';

// contato: título do bloco de contato no fim da página; false para não mostrar (página Contato)
interface Props { titulo: string; descricao: string; imagem?: string; contato?: string | false }
const { titulo, descricao, imagem = '/images/empresa/estoque.jpg', contato = 'Seu redutor parou? Fale com a gente.' } = Astro.props;
const tituloCompleto = titulo === site.nome ? `${site.nome} – Redutores de velocidade em BH` : `${titulo} | ${site.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const atual = Astro.url.pathname;

const naHome = atual === '/';
const ativo = (m: (typeof menu)[number]) => (naHome ? m.secao === 'inicio' : !!m.pagina && atual.startsWith(m.pagina));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  description: 'Venda de redutores, motorredutores e acoplamentos novos e usados, peças e manutenção. Assistência técnica autorizada WEG.',
  foundingDate: String(empresa.fundacao),
  url: Astro.site?.toString(),
  telephone: `+55${site.telefone.replace(/\D/g, '')}`,
  email: site.email,
  image: new URL('/images/empresa/estoque.jpg', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco,
    addressLocality: 'Belo Horizonte',
    addressRegion: 'MG',
    postalCode: site.cep,
    addressCountry: 'BR',
  },
  openingHoursSpecification: [
    site.horario.semana.abre && { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: site.horario.semana.abre, closes: site.horario.semana.fecha },
    site.horario.sabado.abre && { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: site.horario.sabado.abre, closes: site.horario.sabado.fecha },
  ].filter(Boolean),
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0f1938" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={site.nome} />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(imagem, Astro.site)} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="topo">
    <div class="container topo-linha">
      <a class="marca" href="/" aria-label={`${site.nome} – página inicial`}>
        <img src="/images/logo-branco.png" alt={site.nome} width="531" height="80" />
      </a>
      <div class="menu">
        <button type="button" class="menu-botao" aria-expanded="false" aria-controls="menu-principal">Menu</button>
        <nav id="menu-principal" aria-label="Principal">
          <ul>
            {menu.map((m) => (
              <li><a href={hrefSecao(m.secao, naHome)} data-secao={m.secao} aria-current={ativo(m) ? 'true' : undefined}>{m.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <BotaoWhatsapp class="topo-wa" />
    </div>
  </header>

  <main id="conteudo">
    <slot />
  </main>

  {contato && <Contato titulo={contato} />}
  <RodapeEnxuto naHome={naHome} />

  <nav class="barra-movel" aria-label="Contato rápido">
    <a href={linkWhatsapp} class="wa" target="_blank" rel="noopener"><Icone nome="whatsapp" />Orçamento pelo WhatsApp</a>
    <a href={linkTelefone} aria-label={`Ligar ${site.telefone}`}><Icone nome="telefone" />Ligar</a>
  </nav>

  <script>
    import Lenis from 'lenis';
    import 'lenis/dist/lenis.css';

    // Rolagem suave com inércia (como no site de referência).
    // Quem pediu menos movimento no sistema fica com a rolagem normal.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.9 });
      // Links para seções da mesma página: rola suave e desconta o cabeçalho fixo
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        if (link?.hash === '#top') {
          e.preventDefault();
          lenis.scrollTo(0, { duration: 1.4 });
          return;
        }
        const alvo = link && document.getElementById(link.hash.slice(1));
        if (!alvo) return;
        e.preventDefault();
        const topo = document.querySelector<HTMLElement>('.topo')?.offsetHeight ?? 0;
        const y = alvo.getBoundingClientRect().top + window.scrollY - topo;
        lenis.scrollTo(Math.max(0, y), { duration: 1.4 });
        history.replaceState(null, '', link.hash);
      });
      const quadro = (t: number) => { lenis.raf(t); requestAnimationFrame(quadro); };
      requestAnimationFrame(quadro);
    }

    const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
    const fecharMenu = () => botao?.setAttribute('aria-expanded', 'false');
    botao?.addEventListener('click', () => {
      botao.setAttribute('aria-expanded', String(botao.getAttribute('aria-expanded') !== 'true'));
    });

    // Marca no menu a seção que está na tela (só na página inicial)
    const links = [...document.querySelectorAll<HTMLAnchorElement>('#menu-principal a[data-secao]')];
    links.forEach((a) => a.addEventListener('click', fecharMenu));
    const secoes = links
      .map((a) => document.getElementById(a.dataset.secao!))
      .filter((s): s is HTMLElement => !!s);
    if (secoes.length > 1) {
      const topo = document.querySelector<HTMLElement>('.topo');
      let pendente = false;
      const marcar = () => {
        pendente = false;
        const linha = (topo?.offsetHeight ?? 0) + window.innerHeight * 0.3;
        let atual = secoes[0];
        for (const s of secoes) if (s.getBoundingClientRect().top <= linha) atual = s;
        // No fim da página, a última seção é a atual
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) atual = secoes[secoes.length - 1];
        for (const a of links) {
          if (a.dataset.secao === atual.id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      };
      window.addEventListener('scroll', () => {
        if (!pendente) { pendente = true; requestAnimationFrame(marcar); }
      }, { passive: true });
      marcar();
    }
  </script>
</body>
</html>

<style>
  .pular { position: absolute; left: -999px; top: 0; background: #fff; padding: 0.5rem 1rem; z-index: 30; }
  .pular:focus { left: 1rem; }

  .topo { background: var(--azul-noite); color: #fff; position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--azul-linha); }
  .topo-linha { display: flex; align-items: center; gap: 1.8rem; min-height: 4.75rem; }
  .marca img { width: auto; height: 2.4rem; }
  .menu { margin-left: auto; }
  .menu-botao { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.35rem; }
  .menu a { color: #dbe4fb; text-decoration: none; font-weight: 500; padding-block: 0.35rem; border-bottom: 2px solid transparent; white-space: nowrap; text-transform: uppercase; letter-spacing: 0.02em; transition: color .2s, border-color .2s; }
  .menu a:hover { color: #fff; border-color: var(--azul-claro); }
  .menu a[aria-current] { color: #fff; border-color: var(--laranja); }
  .topo :global(.topo-wa) { padding: 0.65rem 1rem; font-size: 0.98rem; white-space: nowrap; }

  @media (max-width: 78rem) {
    .topo-linha { gap: 1rem; min-height: 4.25rem; }
    .marca img { height: 2.1rem; }
    .menu-botao {
      display: block; cursor: pointer; font: 600 1rem/1.2 var(--fonte); color: #fff; background: none;
      padding: 0.55rem 0.95rem; border: 2px solid rgba(255,255,255,.45); border-radius: var(--raio);
    }
    .menu-botao[aria-expanded='true'] { background: rgba(255,255,255,.12); }
    .menu nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--azul-noite); padding: 0.5rem var(--gutter) 1.2rem; border-bottom: 1px solid var(--azul-linha); }
    .menu-botao[aria-expanded='true'] + nav { display: block; }
    .menu ul { flex-direction: column; gap: 0; }
    .menu a { display: block; padding: 0.85rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
    .menu a[aria-current] { color: var(--laranja); border-bottom-color: rgba(255,255,255,.1); }
  }
  @media (max-width: 40rem) {
    .topo :global(.topo-wa) { display: none; }
  }

  .barra-movel { display: none; }
  @media (max-width: 40rem) {
    .barra-movel {
      display: grid; grid-template-columns: 1fr auto; position: fixed; inset: auto 0 0 0; z-index: 20;
      background: #fff; border-top: 1px solid var(--linha); box-shadow: 0 -4px 16px rgba(15,25,56,.15);
      padding: 0.5rem; gap: 0.5rem; padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
    }
    .barra-movel a {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.8rem 1rem; border-radius: var(--raio); font-weight: 600; text-decoration: none;
      background: var(--azul); color: #fff;
    }
    .barra-movel a.wa { background: var(--verde-wa); }
    .barra-movel :global(svg) { width: 1.25rem; height: 1.25rem; }
  }
</style>
