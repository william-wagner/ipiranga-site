---
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import { site, horarios, linkWhatsapp, linkTelefone, enderecoCompleto, linkMapa } from '../lib/site';

interface Props { titulo: string; descricao: string; imagem?: string }
const { titulo, descricao, imagem = '/images/empresa/estoque.jpg' } = Astro.props;
const tituloCompleto = titulo === site.nome ? `${site.nome} – Redutores de velocidade em BH` : `${titulo} | ${site.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const atual = Astro.url.pathname;

const menu = [
  { href: '/', label: 'Início' },
  { href: '/empresa/', label: 'A empresa' },
  { href: '/produtos/', label: 'Produtos' },
  { href: '/manutencao/', label: 'Manutenção' },
  { href: '/aplicacoes/', label: 'Aplicações' },
  { href: '/contato/', label: 'Contato' },
];
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nome,
  description: 'Venda e manutenção de redutores e motorredutores de velocidade. Assistência técnica autorizada WEG Cestari.',
  url: Astro.site?.toString(),
  telephone: `+55${site.telefone.replace(/\D/g, '')}`,
  email: site.email,
  image: new URL('/images/empresa/estoque.jpg', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco,
    addressLocality: 'Belo Horizonte',
    addressRegion: 'MG',
    postalCode: site.cep,
    addressCountry: 'BR',
  },
  openingHoursSpecification: [
    site.horario.semana.abre && { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: site.horario.semana.abre, closes: site.horario.semana.fecha },
    site.horario.sabado.abre && { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: site.horario.sabado.abre, closes: site.horario.sabado.fecha },
  ].filter(Boolean),
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#22387a" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={site.nome} />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(imagem, Astro.site)} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="topo">
    <div class="container topo-linha">
      <a class="marca" href="/" aria-label={`${site.nome} – página inicial`}>
        <img src="/images/logo-branco.png" alt={site.nome} width="531" height="80" />
      </a>
      <div class="menu">
        <button type="button" class="menu-botao" aria-expanded="false" aria-controls="menu-principal">Menu</button>
        <nav id="menu-principal" aria-label="Principal">
          <ul>
            {menu.map((m) => (
              <li><a href={m.href} aria-current={ativo(m.href) ? 'page' : undefined}>{m.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <a class="topo-tel" href={linkTelefone}><Icone nome="telefone" />{site.telefone}</a>
    </div>
  </header>

  <main id="conteudo">
    <slot />
  </main>

  <footer class="rodape">
    <div class="container rodape-grade">
      <div>
        <img src="/images/logo-branco.png" alt={site.nome} width="531" height="80" class="rodape-logo" loading="lazy" />
        <p>Venda e manutenção de redutores e motorredutores de velocidade. Assistência técnica autorizada WEG Cestari.</p>
      </div>
      <div>
        <h2>Contato</h2>
        <ul class="lista-contato">
          <li><Icone nome="telefone" /><a href={linkTelefone}>{site.telefone}</a></li>
          <li><Icone nome="whatsapp" /><a href={linkWhatsapp}>WhatsApp {site.telefone}</a></li>
          <li><Icone nome="email" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icone nome="local" /><a href={linkMapa}>{enderecoCompleto}</a></li>
        </ul>
      </div>
      <div>
        <h2>Horário</h2>
        <dl class="horarios">
          {horarios.map((h) => (<><dt>{h.dias}</dt><dd>{h.horas}</dd></>))}
        </dl>
      </div>
    </div>
    <p class="container rodape-fim">© {new Date().getFullYear()} {site.nome}</p>
  </footer>

  <nav class="barra-movel" aria-label="Contato rápido">
    <a href={linkWhatsapp} class="wa"><Icone nome="whatsapp" />WhatsApp</a>
    <a href={linkTelefone}><Icone nome="telefone" />Ligar</a>
  </nav>

  <script>
    const botao = document.querySelector<HTMLButtonElement>('.menu-botao');
    botao?.addEventListener('click', () => {
      botao.setAttribute('aria-expanded', String(botao.getAttribute('aria-expanded') !== 'true'));
    });
  </script>
</body>
</html>

<style>
  .pular { position: absolute; left: -999px; top: 0; background: #fff; padding: 0.5rem 1rem; z-index: 10; }
  .pular:focus { left: 1rem; }

  .topo { background: var(--azul); color: #fff; position: relative; z-index: 5; }
  .topo-linha { display: flex; align-items: center; gap: 2rem; min-height: 5rem; }
  .marca img { width: auto; height: 2.6rem; }
  .menu { margin-left: auto; }
  .menu-botao { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.6rem; }
  .menu a { color: #fff; text-decoration: none; font-weight: 500; padding-block: 0.35rem; border-bottom: 2px solid transparent; }
  .menu a:hover { border-color: var(--azul-claro); color: #fff; }
  .menu a[aria-current='page'] { border-color: var(--laranja); }
  .topo-tel { display: inline-flex; align-items: center; gap: 0.45rem; color: #fff; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .topo-tel :global(svg) { width: 1.05rem; height: 1.05rem; }
  .topo-tel:hover { color: var(--azul-claro); }

  @media (max-width: 62rem) {
    .topo-tel { display: none; }
  }
  @media (max-width: 52rem) {
    .topo-linha { gap: 1rem; min-height: 4.25rem; }
    .marca img { height: 2.1rem; }
    .menu-botao {
      display: block; cursor: pointer; font: 600 1rem/1.2 var(--fonte); color: #fff; background: none;
      padding: 0.5rem 0.95rem; border: 2px solid rgba(255,255,255,.5); border-radius: 4px;
    }
    .menu-botao[aria-expanded='true'] { background: rgba(255,255,255,.12); }
    .menu nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--azul-escuro); padding: 0.5rem var(--gutter) 1rem; }
    .menu-botao[aria-expanded='true'] + nav { display: block; }
    .menu ul { flex-direction: column; gap: 0; }
    .menu a { display: block; padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,.12); }
    .menu a[aria-current='page'] { color: var(--laranja); border-bottom-color: rgba(255,255,255,.12); }
  }

  .rodape { background: var(--azul-escuro); color: #dfe5f4; margin-top: 0; padding: 3.5rem 0 5.5rem; }
  .rodape a { color: #fff; }
  .rodape h2 { font-size: 1.35rem; color: #fff; margin-bottom: 0.8rem; }
  .rodape-grade { display: grid; grid-template-columns: 1.2fr 1.3fr 1fr; gap: 2.5rem; }
  .rodape-logo { height: 2.2rem; width: auto; margin-bottom: 1rem; }
  .lista-contato { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .lista-contato li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .lista-contato :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; margin-top: 0.25rem; color: var(--azul-claro); }
  .horarios { margin: 0; display: grid; grid-template-columns: auto auto; gap: 0.35rem 1.2rem; justify-content: start; }
  .horarios dt { color: #b9c3dd; }
  .horarios dd { margin: 0; color: #fff; font-weight: 500; }
  .rodape-fim { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid rgba(255,255,255,.12); font-size: 0.9rem; color: #9fabc8; }
  @media (max-width: 52rem) { .rodape-grade { grid-template-columns: 1fr; gap: 2rem; } }

  .barra-movel { display: none; }
  @media (max-width: 52rem) {
    .barra-movel {
      display: grid; grid-template-columns: 1fr 1fr; position: fixed; inset: auto 0 0 0; z-index: 20;
      background: #fff; border-top: 1px solid var(--linha); box-shadow: 0 -4px 16px rgba(22,37,90,.12);
      padding: 0.5rem; gap: 0.5rem; padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
    }
    .barra-movel a {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.75rem; border-radius: 4px; font-weight: 600; text-decoration: none;
      background: var(--azul); color: #fff;
    }
    .barra-movel a.wa { background: var(--laranja); }
    .barra-movel :global(svg) { width: 1.2rem; height: 1.2rem; }
  }
</style>
